# ==============================================================================
# NazeerDFS Environment Configuration Example
# Copy this file to .env and supply environment-specific values.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# Application Environment: 'development', 'test', or 'production'
APP_ENV=development

# HTTP Service Port
PORT=8080

# Node Listen Addresses (comma-separated list for local multi-node or single-node)
NODE_LISTEN_ADDRS=:3000,:4000,:5000

# Bootstrap Node Addresses for P2P network discovery (comma-separated)
BOOTSTRAP_NODES=:3000,:4000

# Storage Directories (comma-separated, corresponding to NODE_LISTEN_ADDRS)
STORAGE_ROOTS=3000_network,4000_network,5000_network

# Master Encryption Key (32 bytes encoded in Base64)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Master Encryption Key ID (for key rotation support)
ENCRYPTION_KEY_ID=k1

# Shared Cluster Secret for P2P Mutual HMAC Authentication (min 16 characters)
# Generate with: openssl rand -base64 24
CLUSTER_SECRET=

# Bootstrap Administrator Credentials (bootstrapped on first run if no admin exists)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# MySQL Database Connection DSN (or standard DB_* variables)
MYSQL_DSN=root:@tcp(127.0.0.1:3306)/nazeerdfs?parseTime=true
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nazeerdfs

# Google Drive Cloud Backup Tier (Optional, leave blank to disable)
# Supply raw JSON text in single quotes, or set credentials file path
CREDENTIALS_JSON=
TOKEN_JSON=
CREDENTIALS_PATH=credentials.json
TOKEN_PATH=token.json

# Transport Layer Security
TLS_ENABLED=false
